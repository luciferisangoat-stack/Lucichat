export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);

    const cors = {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, HEAD, OPTIONS",
      "Access-Control-Allow-Headers": "*",
      "Access-Control-Expose-Headers":
        "Content-Length, Content-Range, Accept-Ranges, ETag"
    };

    // CORS preflight
    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: cors
      });
    }

    // Only GET and HEAD
    if (request.method !== "GET" && request.method !== "HEAD") {
      return new Response("Method not allowed", {
        status: 405,
        headers: cors
      });
    }

    // --------------------------------------------------
    // WORKER TEST
    // --------------------------------------------------

    if (url.pathname === "/proxy-test") {
      return new Response("LuciChat proxy is working!", {
        status: 200,
        headers: {
          ...cors,
          "Content-Type": "text/plain;charset=UTF-8",
          "Cache-Control": "no-store"
        }
      });
    }

    // --------------------------------------------------
    // HUGGING FACE TEST
    // --------------------------------------------------

    if (url.pathname === "/test-hf") {
      const target =
        "https://huggingface.co/mlc-ai/" +
        "SmolLM2-360M-Instruct-q4f32_1-MLC/" +
        "resolve/main/mlc-chat-config.json";

      try {
        const response = await fetch(target, {
          method: "GET",
          redirect: "follow"
        });

        return new Response(
          "HF status: " + response.status + "\n" +
          "HF content-type: " +
          (response.headers.get("content-type") || "unknown"),
          {
            status: 200,
            headers: {
              ...cors,
              "Content-Type": "text/plain;charset=UTF-8",
              "Cache-Control": "no-store"
            }
          }
        );
      } catch (error) {
        return new Response(
          "HF ERROR: " + error.message,
          {
            status: 502,
            headers: {
              ...cors,
              "Content-Type": "text/plain;charset=UTF-8"
            }
          }
        );
      }
    }

    // --------------------------------------------------
    // HUGGING FACE MODEL FILES
    // --------------------------------------------------

    if (url.pathname.startsWith("/hf/")) {
      const path = url.pathname.slice(4);

      const target =
        "https://huggingface.co/" +
        path +
        "/resolve/main/" +
        url.search;

      return proxy(request, target, cors);
    }

    // --------------------------------------------------
    // WEBLLM WASM FILES
    // --------------------------------------------------

    if (url.pathname.startsWith("/lib/")) {
      const path = url.pathname.slice(5);

      const target =
        "https://raw.githubusercontent.com/" +
        "mlc-ai/binary-mlc-llm-libs/main/" +
        "web-llm-models/" +
        path +
        url.search;

      return proxy(request, target, cors);
    }

    // --------------------------------------------------
    // ROOT
    // --------------------------------------------------

    return new Response(
      "LuciChat Worker is running.\n\n" +
      "Tests:\n" +
      "/proxy-test\n" +
      "/test-hf\n\n" +
      "Proxy:\n" +
      "/hf/...\n" +
      "/lib/...",
      {
        status: 200,
        headers: {
          ...cors,
          "Content-Type": "text/plain;charset=UTF-8",
          "Cache-Control": "no-store"
        }
      }
    );
  }
};


// ======================================================
// PROXY
// ======================================================

async function proxy(request, target, cors) {
  try {
    const headers = new Headers();

    // Preserve range requests.
    const range = request.headers.get("Range");

    if (range) {
      headers.set("Range", range);
    }

    // Preserve If-Range.
    const ifRange = request.headers.get("If-Range");

    if (ifRange) {
      headers.set("If-Range", ifRange);
    }

    const response = await fetch(target, {
      method: request.method,
      headers,
      redirect: "follow"
    });

    // Don't pass every upstream header through.
    // Some upstream headers can cause browser Cache API
    // failures.
    const out = new Headers();

    const contentType =
      response.headers.get("Content-Type");

    const contentLength =
      response.headers.get("Content-Length");

    const contentRange =
      response.headers.get("Content-Range");

    const etag =
      response.headers.get("ETag");

    const lastModified =
      response.headers.get("Last-Modified");

    const cacheControl =
      response.headers.get("Cache-Control");

    if (contentType) {
      out.set("Content-Type", contentType);
    }

    if (contentLength) {
      out.set("Content-Length", contentLength);
    }

    if (contentRange) {
      out.set("Content-Range", contentRange);
    }

    if (etag) {
      out.set("ETag", etag);
    }

    if (lastModified) {
      out.set("Last-Modified", lastModified);
    }

    if (cacheControl) {
      out.set("Cache-Control", cacheControl);
    }

    // Required CORS headers.
    for (const [key, value] of Object.entries(cors)) {
      out.set(key, value);
    }

    // WebLLM uses range requests for large files.
    out.set("Accept-Ranges", "bytes");

    return new Response(response.body, {
      status: response.status,
      statusText: response.statusText,
      headers: out
    });

  } catch (error) {
    return new Response(
      "Proxy error: " + error.message,
      {
        status: 502,
        headers: {
          ...cors,
          "Content-Type":
            "text/plain;charset=UTF-8",
          "Cache-Control": "no-store"
        }
      }
    );
  }
}
